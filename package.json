    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "metal-fx": "^1.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
