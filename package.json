{
  "name": "imagen",
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && NODE_ENV=development electron .",
    "dev": "concurrently \"pnpm run dev:vite\" \"pnpm run dev:electron\"",
    "build": "vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.7",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@libsql/client": "^0.17.3",
    "@number-flow/react": "^0.6.0",
    "cli-spinners": "^3.4.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.1",
    "lucide-react": "^1.16.0",
    "metal-fx": "^1.0.4",
    "nanoid": "^3.3.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-window": "^2.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "sharp"
    ]
  }
}
